# Product app (header Sign in / Create account links)
NEXT_PUBLIC_APP_URL=https://app.limespun.com
# Public status page with uptime history (BetterStack/Instatus). Footer links to it when set.
NEXT_PUBLIC_STATUS_URL=

# Marketing form delivery
RESEND_API_KEY=
RESEND_FROM="Limespun <hello@boldteq.com>"
BOLDTEQ_INBOX=hello@boldteq.com
# Resend segment that footer newsletter signups are added to (falls back to emailing BOLDTEQ_INBOX)
RESEND_NEWSLETTER_SEGMENT_ID=

# Form rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Founding lifetime offer on /pricing and the homepage. Set to "closed" the day the 300 places sell out.
NEXT_PUBLIC_FOUNDING_OFFER=open

# Show the 3 "Sample" video-review cards on the homepage (local/preview only; never set in production).
NEXT_PUBLIC_SHOW_SAMPLE_REVIEWS=false
